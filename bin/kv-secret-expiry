#!/usr/bin/env bash
#
# kv-secret-expiry - list Azure Key Vault secrets and certificates that are
# expired or expire soon. Reads metadata only, never secret values.

set -euo pipefail

_self_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" == /* ]] || src="${dir}/${src}"
  done
  cd -P "$(dirname "$src")" && pwd
}
# shellcheck source=../lib/common.sh
source "$(_self_dir)/../lib/common.sh"

usage() {
  cat <<'EOF'
Usage: kv-secret-expiry (--vault NAME... | --all-vaults) [options]

Report Key Vault secrets and certificates by expiry status. Only metadata is
read; secret values are never requested.

Scope:
  -k, --vault NAME         Key Vault to inspect (repeatable)
      --all-vaults         Every vault in the subscription
  -s, --subscription ID    Subscription (default: current)

Thresholds and filters:
  -w, --warning DAYS       Warning threshold (default: 30)
  -c, --critical DAYS      Critical threshold (default: 7)
      --warn-no-expiry     Treat items without an expiry date as WARNING
      --no-certificates    Secrets only
      --all                Also list items that are OK
  -f, --format FORMAT      table | json (default: table)
  -v, --verbose | -q, --quiet | --no-color | --version | -h, --help

Statuses: EXPIRED, CRITICAL, WARNING, NO_EXPIRY, OK, DISABLED.
Certificate-backed secrets (managed=true) are skipped to avoid duplicates.

Exit codes (worst result wins):
  0 OK   1 WARNING   2 CRITICAL or EXPIRED   3 a vault could not be read
  64 usage error   69 missing dependency

Permissions: "Key Vault Reader" (RBAC vaults) or list permission on secrets
and certificates (access policy vaults). Neither grants access to values.

Examples:
  kv-secret-expiry -k kv-app-dev-weu
  kv-secret-expiry --all-vaults -w 45 --warn-no-expiry --format json
EOF
}

vaults=() all_vaults=0 subscription="" warn_days=30 crit_days=7
warn_no_expiry=0 certificates=1 show_all=0 format=table

azc() {
  az "$@" ${subscription:+--subscription "$subscription"} -o json
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help)
        usage
        exit 0
        ;;
      -k | --vault)
        require_arg "$@"
        vaults+=("$2")
        shift
        ;;
      --all-vaults) all_vaults=1 ;;
      -s | --subscription)
        require_arg "$@"
        subscription="$2"
        shift
        ;;
      -w | --warning)
        require_arg "$@"
        is_positive_int "$2" || usage_error "--warning must be a whole number of days"
        warn_days="$2"
        shift
        ;;
      -c | --critical)
        require_arg "$@"
        is_positive_int "$2" || usage_error "--critical must be a whole number of days"
        crit_days="$2"
        shift
        ;;
      --warn-no-expiry) warn_no_expiry=1 ;;
      --no-certificates) certificates=0 ;;
      --all) show_all=1 ;;
      -f | --format)
        require_arg "$@"
        case "$2" in table | json) format="$2" ;; *) usage_error "unknown format: $2" ;; esac
        shift
        ;;
      *)
        handle_common_flag "$1" || usage_error "unknown option: $1"
        ;;
    esac
    shift
  done
  if ((all_vaults == 0)) && ((${#vaults[@]} == 0)); then
    usage_error "give at least one --vault or --all-vaults"
  fi
  ((crit_days <= warn_days)) || usage_error "--critical must not exceed --warning"
}

# classify VAULT KIND JSON - turn a list response into status records.
classify() {
  jq -c --arg vault "$1" --arg kind "$2" --argjson now "$(now_epoch)" \
    --argjson warn "$warn_days" --argjson crit "$crit_days" --argjson nox "$warn_no_expiry" '
    def epoch: sub("\\.[0-9]+"; "") | sub("(\\+00:00|Z)?$"; "Z") | fromdateiso8601;
    .[] | select(.managed != true)
    | (.attributes.expires // null) as $exp
    | (if $exp then (($exp | epoch) - $now) / 86400 | floor else null end) as $days
    | {vault: $vault, kind: $kind,
       name: (.name // (.id | split("/") | last)),
       expires: $exp, daysLeft: $days,
       status: (if .attributes.enabled == false then "DISABLED"
                elif $days == null then "NO_EXPIRY"
                elif $days < 0 then "EXPIRED"
                elif $days <= $crit then "CRITICAL"
                elif $days <= $warn then "WARNING"
                else "OK" end)}
    | . + {severity: (if .status == "EXPIRED" or .status == "CRITICAL" then 2
                      elif .status == "WARNING" or (.status == "NO_EXPIRY" and $nox == 1) then 1
                      else 0 end)}' <<<"$3"
}

main() {
  parse_args "$@"
  require_cmd az jq

  if ((all_vaults)); then
    local v
    while IFS= read -r v; do
      if [[ -n "$v" ]]; then vaults+=("$v"); fi
    done < <(azc keyvault list --query '[].name' | jq -r '.[]')
    ((${#vaults[@]} > 0)) || die "no Key Vaults found in scope" "$EX_UNKNOWN"
  fi

  local records="" vault json unreadable=0
  for vault in "${vaults[@]}"; do
    log_info "reading metadata from ${vault}"
    if json="$(az keyvault secret list --vault-name "$vault" -o json 2>/dev/null)"; then
      records+="$(classify "$vault" secret "$json")"$'\n'
    else
      log_error "${vault}: cannot list secrets (missing permission or firewall?)"
      unreadable=1
    fi
    if ((certificates)); then
      if json="$(az keyvault certificate list --vault-name "$vault" -o json 2>/dev/null)"; then
        records+="$(classify "$vault" certificate "$json")"$'\n'
      else
        log_error "${vault}: cannot list certificates"
        unreadable=1
      fi
    fi
  done

  local all worst
  all="$(jq -s -c 'sort_by(.daysLeft // 1e9)' <<<"$records")"
  worst="$(jq '[.[].severity] | max // 0' <<<"$all")"
  if ((show_all == 0)); then
    all="$(jq -c --argjson nox "$warn_no_expiry" 'map(select(.status != "OK" and (.status != "NO_EXPIRY" or $nox == 1)))' <<<"$all")"
  fi

  if [[ "$format" == json ]]; then
    jq 'map(del(.severity))' <<<"$all"
  elif [[ "$(jq length <<<"$all")" == 0 ]]; then
    echo "Nothing expires within ${warn_days} days."
  else
    printf '%-24s %-12s %-40s %-10s %-26s %s\n' VAULT KIND NAME DAYS_LEFT EXPIRES STATUS
    jq -r '.[] | [.vault, .kind, .name, (.daysLeft // "-" | tostring), (.expires // "-"), .status] | @tsv' <<<"$all" |
      while IFS=$'\t' read -r vault kind name days exp status; do
        printf '%-24s %-12s %-40s %-10s %-26s %s\n' "$vault" "$kind" "$name" "$days" "$exp" "$status"
      done
  fi

  if ((worst == 0 && unreadable)); then
    return "$EX_UNKNOWN"
  fi
  return "$worst"
}

main "$@"
